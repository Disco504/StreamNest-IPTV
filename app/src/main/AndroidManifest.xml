<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="StreamNest IPTV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/streamnest_splash"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.streamnest.iptv.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name="com.streamnest.iptv.MainActivity"
            android:theme="@style/StreamNestLaunchTheme"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
